{
    "Server": {
        "Address": "unix:///run/opensnitch/osui.sock",
        "LogFile": "/dev/stdout"
    },
    "DefaultAction": "deny",
    "DefaultDuration": "once",
    "InterceptUnknown": true,
    "ProcMonitorMethod": "proc",
    "LogLevel": 1,
    "Firewall": "iptables",
    "FwOptions": {
        "ConfigPath": "/etc/opensnitchd/system-fw.json",
        "MonitorInterval": "10s",
        "QueueBypass": false
    },
    "Rules": {
        "Path": "/etc/opensnitchd/rules/",
        "EnableChecksums": false
    },
    "Stats": {
        "MaxEvents": 250,
        "MaxStats": 50
    }
}

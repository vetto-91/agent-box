# ==============================================================================
# Configurazione Agent-Box (Hardened & Unprivileged)
# Nota: PUID, PGID, DISPLAY, WAYLAND_DISPLAY e XDG_RUNTIME_DIR vengono
# rilevati ed esportati automaticamente da ./agent-box.sh ad ogni avvio.
# ==============================================================================

# Cartella del progetto da montare in /workspace dentro il container dell'agente
WORKSPACE_DIR=./workspace

# Controllo DNS in OpenSnitch:
# AUTO_DNS=1 -> consente la risoluzione DNS (porta 53) senza doppio popup, ma
#               chiede comunque conferma su ogni connessione TCP/UDP/HTTP(S)
# AUTO_DNS=0 -> intercetta e chiede conferma su OGNI singola query DNS
AUTO_DNS=1

# Accesso a Ollama:
# AUTO_ALLOW_OLLAMA=1 -> pre-autorizza a livello OpenSnitch il traffico verso
#                        Ollama (porta 11434) senza popup
# AUTO_ALLOW_OLLAMA=0 -> anche le chiamate a Ollama passano da OpenSnitch UI
AUTO_ALLOW_OLLAMA=0
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_PORT=11434

# Modelli locali OpenAI-compatibili (Ollama, LM Studio, vLLM, llama.cpp, HTTPS self-signed)
# Esempio: LOCAL_LLM_BASE_URL=https://192.168.1.50:8443/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=qwen2.5-coder:latest
LOCAL_LLM_NAME=Local LLM
# Imposta a 1 per rigenerare automaticamente i file di config locali (opencode/pi/codex) ad ogni avvio:
AGENT_REGENERATE_LOCAL_CONFIG=0
# Imposta a 1 SOLO per endpoint HTTPS locali con certificato self-signed senza CA in ./certs:
AGENT_TLS_INSECURE=0

# Limiti risorse container Agent
# AGENT_CPUS vuoto, 0 o "all" -> usa TUTTI i core della CPU dell'host (default)
AGENT_MEM_LIMIT=8g
AGENT_CPUS=
AGENT_SHM_SIZE=512m

# Volumi extra del progetto sul disco (separati da virgola o punto e virgola)
# Esempio: AGENT_EXTRA_VOLUMES=/mnt/datasets:/datasets:ro,/percorso/shared:/shared:rw
AGENT_EXTRA_VOLUMES=

# Accelerazione grafica / GPU per l'agente e le app del progetto:
# auto   -> abilita automaticamente iGPU (/dev/dri, /dev/kfd) e GPU NVIDIA se presenti (default)
# all    -> abilita sia iGPU che NVIDIA
# igpu   -> solo GPU integrata (/dev/dri, /dev/kfd)
# nvidia -> solo GPU NVIDIA
# none   -> nessuna GPU
AGENT_GPU=auto

# Finestre grafiche (X11, XWayland, Wayland) per Claude, agenti AI e app del progetto:
# auto     -> rileva Wayland + XWayland/X11 automaticamente (default)
# wayland  -> forza Wayland nativo
# xwayland -> forza XWayland/X11
# x11      -> forza X11
# none     -> disabilita l'accesso grafico per l'agente
AGENT_DISPLAY_MODE=auto

# Accesso Audio e Microfono per l'agente e le app del progetto:
# AGENT_AUDIO=1 (default) -> abilita l'uscita audio (altoparlanti/cuffie)
# AGENT_MIC=0   (default) -> microfono DISABILITATO e isolato a livello fisico/socket (imposta a 1 per abilitarlo)
AGENT_AUDIO=1
AGENT_MIC=0

# Finestra principale OpenSnitch UI all'avvio (1=aperta di default, 0=solo tray/popup)
OPENSNITCH_SHOW_MAIN_WINDOW=1

# Profilo regole OpenSnitch preimpostato (lascia vuoto per mantenere le regole attuali in ./opensnitch/rules):
# Valori supportati (importabili anche da GUI in /home/snitch/opensnitch-profiles):
#   0-interattivo-default       (alias: interattivo)      -> solo loopback + DNS, chiede conferma via popup
#   1-disabilitato-allow-all    (alias: disabilitato)     -> consente tutto il traffico
#   2-solo-lan                  (alias: solo-lan)         -> consente solo LAN privata, blocca Internet
#   3-solo-lan-con-provider-ia  (alias: solo-lan-ia)      -> consente solo LAN + API provider IA, blocca resto Internet
#   4-solo-internet-no-lan      (alias: solo-internet)    -> consente Internet pubblica, blocca LAN privata
#   5-solo-provider-ia          (alias: solo-provider-ia) -> consente solo API provider IA, blocca LAN e resto Internet
#   6-solo-443-ipv4             (alias: solo-443-ipv4)    -> consente solo porta 443 IPv4 (+ DNS/loopback)
OPENSNITCH_PROFILE=

# API Keys opzionali (lascia vuote se usi modelli locali o login interattivo)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
XAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
